# shellcheck configuration for blackoutsecure/bos-repo-about-sync-action.
#
# The composite action's `run:` block is invoked by GitHub Actions
# runners with bash, so we tell shellcheck to assume that interpreter
# regardless of any missing shebang in extracted snippets.
#
# Disabled checks:
#   SC2016 — Expressions don't expand in single quotes. We deliberately
#            single-quote ${{ github.* }} so the runner expands them,
#            not the shell.
#   SC1091 — Not following sourced file. run.sh sources lib.sh from a
#            relative path shellcheck can't resolve at lint time
#            outside the action's runtime cwd.

enable=quote-safe-variables
enable=require-variable-braces

# >>> managed-file-sync:shellcheck >>>
shell=bash
disable=SC2016,SC1091
external-sources=true
# <<< managed-file-sync:shellcheck <<<
