# Repo-specific ignores. The hub's `common` block covers OS/editor
# noise, secrets, and logs; the `python_ecosystem` service covers
# Python venvs, caches, and packaging output.

# Local scratch
/tmp/
scratch/
*.local
pytest-results.xml

# >>> managed-file-sync:common >>>
# OS + editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Build + dependency output
node_modules/
dist/
build/
coverage/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local secrets (never commit these)
.env
.env.*
!.env.example
# <<< managed-file-sync:common <<<

# >>> managed-file-sync:coverage_artifacts >>>
.coverage
.coverage.*
coverage.xml
htmlcov/
# <<< managed-file-sync:coverage_artifacts <<<
